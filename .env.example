# Names only. Copy to .env (git-ignored) and fill in locally; never commit values.

# Live (Base Sepolia) runs
RPC_URL=
CHAIN_ID=84532
# Four distinct, disposable wallets funded with Base Sepolia ETH (the client also needs ~6 USDC)
CLIENT_KEY=
PROVIDER_KEY=
STRANGER_KEY=
JUDGE_KEY=
# Path to the Solana keypair file of a Molpha-subscribed wallet (read by the SDK in memory only)
MOLPHA_KEYPAIR=
MOLPHA_GATEWAY=https://gateway.molpha.io/

# What the jobs settle on
GITHUB_PR=            # owner/repo#number: a PR you will merge during the run
GITHUB_OPEN_PR=       # owner/repo#number: a PR that stays open
DNS_HOST=             # a domain you control, where you add the TXT record
DNS_TOKEN=molpha-job=8183

# Optional
EXPIRY_MINUTES=30
BUDGET_USDC=1
